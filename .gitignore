# Secrets and local config
.env
.env.local
deploy/.env.lan

# Local backups (v0.2 Phase 2 default; see docs/operations/backup-restore.md).
backups/

# Python bytecode and caches
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.ruff_cache/
.mypy_cache/

# uv / virtualenv
.venv/
venv/

# Build and packaging artifacts
build/
dist/
*.egg-info/

# Logs
*.log

# AI assistant tooling — not tracked
.agent/
.codex/
.gemini/
.windsurf/
.specstory/

# Claude Code — ignore tool config, but keep this project's skills
.claude/*
!.claude/skills/

# GitHub tooling: ignore the Copilot prompts and the skills mirror (canonical
# skills live under .claude/skills/), but DO track the Actions workflows so a
# fresh clone from the remote gets CI.
.github/*
!.github/workflows/

# Understand-Anything plugin scratch (generated scan/batch cache)
.understand-anything/

# Editor / IDE
.vscode/
*.code-workspace

# Generated wiki pages — the vault directory structure is tracked, but the
# page content is generated at runtime and is per-user, not repo content.
vault/concepts/*.md
vault/topics/*.md
vault/sources/*.md

# OS cruft
.DS_Store
*.swp
mutants/
