# Compendium LAN deployment env. Copy to deploy/.env.lan and fill in keys.
#   cp deploy/.env.lan.example deploy/.env.lan
#
# These store URLs use the compose SERVICE NAMES and the stores' INTERNAL
# ports (not the dev compose's remapped host ports). The serve container
# reaches the stores over the compose network; the stores are not published.

# --- Published bind address ---
# LAN IP this server publishes the access surface on. Set to this server's
# address (e.g. 192.168.35.70). 0.0.0.0 binds all interfaces; pair that with a
# host firewall rule (see deploy/README-lan.md).
BIND_HOST=0.0.0.0

# --- Storage backends (compose-internal) ---
POSTGRES_URL=postgresql://compendium:compendium@postgres:5432/compendium
OPENSEARCH_URL=http://opensearch:9200
QDRANT_URL=http://qdrant:6333
MEMGRAPH_URL=bolt://memgraph:7687

# --- Vault (mounted volume inside the serve container) ---
VAULT_PATH=/app/vault

# --- Synthesis LLM ---
# Only needed for ingest / ask / synthesis. Plain `query` over existing pages
# does not call the LLM. Leave the key blank if you only serve queries.
SYNTHESIS_ENDPOINT=https://openrouter.ai/api/v1
SYNTHESIS_MODEL=anthropic/claude-sonnet-4.5
OPENROUTER_API_KEY=

# --- Embeddings ---
# Needed to embed queries for dense retrieval and to index new content.
EMBEDDINGS_ENDPOINT=https://openrouter.ai/api/v1
EMBED_MODEL=BAAI/bge-m3
EMBEDDINGS_API_KEY=
