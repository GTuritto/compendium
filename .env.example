# Compendium environment configuration
#
# Copy this file to .env and fill in the values:
#   cp .env.example .env
#
# .env holds secrets and storage URLs and is never committed.
# Non-secret behavior config lives in config/settings.yaml.

# --- Storage backends ---

# PostgreSQL: the operational system of record.
# Must match the credentials in docker-compose.yml.
POSTGRES_URL=postgresql://compendium:compendium@localhost:5432/compendium

# OpenSearch: lexical (BM25) index. Derived from Postgres + vault. (Phase 4)
OPENSEARCH_URL=http://localhost:9200

# Qdrant: vector index. Derived from Postgres + vault. (Phase 4)
QDRANT_URL=http://localhost:6333

# Memgraph: structural knowledge graph. (Phase 6)
MEMGRAPH_URL=bolt://localhost:7687

# --- LLM and embeddings ---

# OpenRouter: gateway for synthesis LLM calls. Get a key at openrouter.ai.
OPENROUTER_API_KEY=

# Embedding model used for dense retrieval.
EMBED_MODEL=BAAI/bge-m3

# --- Vault ---

# Filesystem path to the canonical Markdown wiki.
VAULT_PATH=./vault
