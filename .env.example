# Compendium environment configuration
#
# Copy this file to .env and fill in the values:
#   cp .env.example .env
#
# .env holds secrets and per-machine values and is never committed.
# config/settings.yaml references these variables by name and holds the
# non-secret behavior configuration.

# --- Storage backends ---

# PostgreSQL: the operational system of record. Matches docker-compose.yml.
POSTGRES_URL=postgresql://compendium:compendium@localhost:5432/compendium

# OpenSearch: lexical (BM25) index. (Phase 4)
OPENSEARCH_URL=http://localhost:9200

# Qdrant: vector index. (Phase 4) Host port remapped to 6533 (see
# docker-compose.yml) so Compendium coexists with other local Qdrant instances.
QDRANT_URL=http://localhost:6533

# Memgraph: structural knowledge graph. (Phase 6)
MEMGRAPH_URL=bolt://localhost:7688

# --- Vault ---

# Filesystem path to the canonical Markdown wiki.
VAULT_PATH=./vault

# --- Synthesis LLM (Phase 3) ---
#
# OpenAI-compatible endpoint. Two supported options:
#   - OpenRouter (cloud):           https://openrouter.ai/api/v1
#   - Docker Model Runner (local):  the DMR OpenAI-compatible base URL
SYNTHESIS_ENDPOINT=https://openrouter.ai/api/v1
SYNTHESIS_MODEL=anthropic/claude-sonnet-4.5

# API key for the synthesis endpoint. Required for OpenRouter; leave blank
# when SYNTHESIS_ENDPOINT points at Docker Model Runner (local, no key).
OPENROUTER_API_KEY=

# --- Embeddings (Phase 4) ---
#
# OpenAI-compatible endpoint. Two supported options:
#   - OpenRouter (cloud, paid):    https://openrouter.ai/api/v1
#   - Docker Model Runner (local): the DMR OpenAI-compatible base URL,
#     when the chosen embeddings model is in the DMR catalogue.
# BGE-M3 is not in the current DMR catalogue, so the Apple Silicon
# strategy uses OpenRouter for embeddings (see docs/operations/real-models.md).
EMBEDDINGS_ENDPOINT=https://openrouter.ai/api/v1
EMBED_MODEL=BAAI/bge-m3

# API key for the embeddings endpoint. Required for OpenRouter; leave blank
# when EMBEDDINGS_ENDPOINT points at Docker Model Runner (local, no key).
# When using OpenRouter for both seams, set the same value as OPENROUTER_API_KEY.
EMBEDDINGS_API_KEY=

# --- Backup (v0.2 Phase 2) ---
#
# Local directory for backup pairs. Each `compendium backup` writes a new
# subdirectory `<BACKUP_LOCAL_DIR>/<UTC-timestamp>/` containing
# `compendium.dump` (pg_dump --format=custom) and `vault.tar.gz`. Default is
# `./backups` (in-repo, gitignored).
BACKUP_LOCAL_DIR=./backups

# Optional off-host rsync destination. When set, every `compendium backup`
# additionally runs `rsync -a` of the timestamped subdir to the destination.
# Anything `rsync` accepts works: `user@host:/path`, `/mnt/nas/backups`,
# `rsync://host/module/path`. Leave empty for local-only backups.
BACKUP_RSYNC_DEST=

# --- Inbox (v0.2 Phase 4) ---
#
# Filesystem path to the auto-ingestion inbox. The path holds one
# subdirectory per source kind (book/article/paper/note/web) plus
# processed/ and failed/. Files dropped under <INBOX_PATH>/<kind>/
# are auto-ingested with that kind by the watcher unit installed by
# `compendium inbox install`. See docs/operations/inbox.md.
INBOX_PATH=~/Compendium/inbox
